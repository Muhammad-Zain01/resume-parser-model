HF_DATASET_REPO=md-zain/resume-parser-dataset
HF_DATASET_REVISION=main

# Hugging Face access token used for authenticated dataset operations.
HF_TOKEN=hf_your_huggingface_token_here

# TypeSafe AI Jev key used by the evaluation judge.
TYPESAFE_API_KEY=your_typesafe_api_key_here

# OpenRouter API key used for API inference.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hugging Face model repository for fine-tuned adapters and checkpoints.
HF_MODEL_REPO=md-zain/resume-parser-qwen2.5-3b

# Weights & Biases experiment tracking used by step 05 fine-tuning.
WANDB_API_KEY=your_wandb_api_key_here
WANDB_ENTITY=zainmemon010-personal
WANDB_PROJECT=resume-parser