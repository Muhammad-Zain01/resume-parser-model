# Hugging Face username that owns the dataset repository.
HF_USERNAME=your-huggingface-username

# Dataset repository name, without the username prefix.
HF_DATASET_REPO=your-dataset-repo

# Dataset branch or revision.
HF_DATASET_REVISION=main

# Hugging Face access token used for authenticated dataset operations.
HF_TOKEN=hf_your_huggingface_token_here

# TypeSafe AI Jev key used by the evaluation judge.
TYPESAFE_API_KEY=your_typesafe_api_key_here
